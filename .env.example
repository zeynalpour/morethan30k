# ---------------------------------------------------------------------------
# TME environment configuration. Copy to `.env` and fill in real values.
#   cp .env.example .env
# All variables are read by `tme.config.Settings` (pydantic-settings).
# ---------------------------------------------------------------------------

# --- Controller ("Main") bot ------------------------------------------------
# Token of the Main Bot that users talk to in order to create their own bots.
MAIN_BOT_TOKEN=123456:REPLACE_WITH_MAIN_BOT_TOKEN

# --- Public base URL --------------------------------------------------------
# Public HTTPS origin Telegram will call back on, e.g. https://tme.example.com
# The per-bot webhook becomes:  {WEBHOOK_BASE_URL}/webhook/{bot_token}
WEBHOOK_BASE_URL=https://your-public-domain.example.com

# Shared secret sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header.
# We register it via setWebhook and verify it on every incoming request.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- PostgreSQL -------------------------------------------------------------
# SQLAlchemy async URL (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://tme:tme@localhost:5432/tme

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# TTL (seconds) for cached bot configs in Redis. Config edits invalidate the
# key immediately; this TTL is just a backstop against stale data.
CONFIG_CACHE_TTL=3600

# --- Runtime ----------------------------------------------------------------
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
