# ---------------------------------------------------------------------------
# TME environment configuration. Copy to `.env` and fill in real values.
#   cp .env.example .env
# All variables are read by `tme.config.Settings` (pydantic-settings).
# ---------------------------------------------------------------------------

# --- Controller ("Main") bot ------------------------------------------------
# Token of the Main Bot that users talk to in order to create their own bots.
MAIN_BOT_TOKEN=123456:REPLACE_WITH_MAIN_BOT_TOKEN

# --- Public base URL --------------------------------------------------------
# Public HTTPS origin Telegram will call back on, e.g. https://tme.example.com
# The per-bot webhook becomes:  {WEBHOOK_BASE_URL}/webhook/{bot_token}
WEBHOOK_BASE_URL=https://your-public-domain.example.com

# Shared secret sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header.
# We register it via setWebhook and verify it on every incoming request.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- PostgreSQL -------------------------------------------------------------
# SQLAlchemy async URL (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://tme:tme@localhost:5432/tme

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# TTL (seconds) for cached bot configs in Redis. Config edits invalidate the
# key immediately; this TTL is just a backstop against stale data.
CONFIG_CACHE_TTL=3600

# --- Runtime ----------------------------------------------------------------
# Lifecycle stage: dev | test | prod.
#   dev  — userbot E2E tests enabled (tests/test_e2e_telegram.py collects).
#   test — userbot E2E skips; human manual verification required (tracked by
#          the QA agent on GitHub when a PR merges to main).
#   prod — never runs E2E; deployments happen via git tags only.
# Unset/unknown → the E2E module skips, so CI and stray boxes stay safe.
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- Dev-only: Telegram userbot E2E (tests/test_e2e_telegram.py) -------------
# Account that talks to the controller bot as a real user. Generate with:
#   uv run python scripts/gen_userbot_session.py
# Get api_id/api_hash at https://my.telegram.org → API development tools.
# Only required when APP_ENV=dev; the test skips gracefully when absent.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STRING_SESSION=
